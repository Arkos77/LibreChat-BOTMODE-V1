# Never commit real values. This is a CENTRAL registry, NOT the MongoDB of a BOT MODE installation.
REGISTRY_PUBLIC_URL=https://updates.example.org
REGISTRY_PORT=8789
REGISTRY_MONGODB_URI=mongodb://registry_user:CHANGE_ME@127.0.0.1:27017/botmode_updates?authSource=botmode_updates
REGISTRY_DB_NAME=botmode_updates
REGISTRY_ADMIN_TOKEN=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
REGISTRY_UNSUBSCRIBE_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_SECRET
REGISTRY_SMTP_HOST=smtp.example.org
REGISTRY_SMTP_PORT=587
REGISTRY_SMTP_USER=updates@example.org
REGISTRY_SMTP_PASSWORD=REPLACE_WITH_SMTP_SECRET
REGISTRY_SMTP_FROM=updates@example.org
# REGISTRY_CONFIRM_SEND=YES  # only when intentionally mailing a release
